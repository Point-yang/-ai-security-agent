# 本地默认 SQLite；成员协作和部署使用 PostgreSQL。
ZHIDU_DATABASE_URL=sqlite:///./data/zhidu.db
ZHIDU_RAW_DIR=./data/raw
# 源码仓库不附 embedding 模型；语义检索需先准备模型并运行 semantic-sync。
# ZHIDU_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# ZHIDU_EMBEDDING_CACHE=./data/models
# ZHIDU_EMBEDDING_MANIFEST=./data/models/manifest.json
# ZHIDU_RAG_CONFIG=./config/member-b-week6-router-v2.json
# PostgreSQL 示例（使用自行设置的密码）：
# ZHIDU_DATABASE_URL=postgresql+psycopg://zhidu:CHANGE_ME@localhost:5432/zhidu

# 公共公告可匿名获取；可选 token 提高额度。不要提交真实 token。
ZHIDU_GITHUB_TOKEN=
ZHIDU_GITHUB_API_VERSION=2026-03-10

# 留空时所有 HTTP 写接口禁用；CLI 导入不受影响。
ZHIDU_ADMIN_KEY=

# DeepSeek：问题与检索到的来源片段会发送至官方 API。密钥只保存在服务端。
# 不使用云端回答时设为 extractive；embedding 仍在本地运行。
ZHIDU_LLM_PROVIDER=extractive
ZHIDU_DEEPSEEK_API_KEY=
ZHIDU_DEEPSEEK_BASE_URL=https://api.deepseek.com
# 供应商实际返回型号以每次回答审计为准。
ZHIDU_DEEPSEEK_MODEL=deepseek-v4-flash
ZHIDU_DEEPSEEK_TIMEOUT_SECONDS=60
ZHIDU_DEEPSEEK_MAX_TOKENS=2400
# 普通生成、固定工作流和新 Agent 共用的温度。
ZHIDU_LLM_TEMPERATURE=0
# 请求 agent_backend=team 启用多角色；langchain 启用原生工具循环；workflow 为默认。
ZHIDU_AGENT_BACKEND=workflow
ZHIDU_AGENT_MAX_MODEL_CALLS=8
ZHIDU_AGENT_MAX_TOOL_CALLS=6
# 工具累计返回字符（包括模型可见元数据）；对照评测统一使用 18000。
ZHIDU_AGENT_MAX_OUTPUT_CHARS=24000
ZHIDU_AGENT_DEADLINE_SECONDS=60
# 在软截止前为最终 JSON 回答预留时间（不增加调用上限）。
ZHIDU_AGENT_FINAL_RESERVE_SECONDS=8
# 新 Agent 和 generation=model 共用此模型适配层。
# deepseek / openai_compatible / ollama；其他供应商使用独立密钥，不沿用 DeepSeek Key。
ZHIDU_AGENT_MODEL_PROVIDER=deepseek
# ZHIDU_AGENT_MODEL_NAME=your-tool-capable-model
# ZHIDU_AGENT_MODEL_BASE_URL=https://your-gateway.example/v1
ZHIDU_AGENT_MODEL_API_KEY=
ZHIDU_AGENT_CHECKPOINT_PATH=./data/agent-checkpoints.sqlite
ZHIDU_RAG_TURN_LEASE_SECONDS=180
ZHIDU_RAG_TURN_DUPLICATE_WAIT_SECONDS=2
# B 的本地前端使用此地址；如端口不同，修改 JSON 数组。
ZHIDU_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# 仅 Docker Compose 使用。替换为随机、URL-safe 的密码。
POSTGRES_PASSWORD=

# 可选：Docker Hub 不可达时使用 Docker Official Images 的 ECR 分发地址。
# ZHIDU_PYTHON_BASE=public.ecr.aws/docker/library/python:3.12-slim
# ZHIDU_API_PORT=8000
# ZHIDU_DB_PORT=5432
