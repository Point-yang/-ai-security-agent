                "text": "Potential Timing Side-Channel Vulnerability in vLLM’s Chunk-Based Prefix Caching",
                "text_truncated": false
              },
              {
                "citation": {
                  "chunk_id": "d0714327769c112c0862b69a",
                  "event_id": "1868db90-f569-426c-96d9-bf691a25088d",
                  "revision_id": "249beafe-bec3-4494-ab09-406fd96b85fd",
                  "revision": 1,
                  "raw_document_id": "6e452537-d696-4fa9-94c4-7ca8a27b2142",
